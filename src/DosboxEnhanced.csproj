<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DosboxEnhanced</AssemblyName><RootNamespace>DosboxEnhanced</RootNamespace>
    <Version>0.6.0</Version><AssemblyVersion>0.6.0.0</AssemblyVersion><FileVersion>0.6.0.0</FileVersion>
    <Product>DOSBox Enhanced</Product><Description>A friendly DOS workspace with optional neural graphics and built-in MCP.</Description>
    <Deterministic>true</Deterministic><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup><PackageReference Include="SharpCompress" Version="0.50.7" /></ItemGroup>
  <ItemGroup><Compile Remove="Phoenix.cs;NvidiaRuntimes.cs" /></ItemGroup>
</Project>
