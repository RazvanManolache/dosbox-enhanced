{
  "version": "0.5",
  "scope": "Visual starting points selected for the pictured scenes; not universal quality or performance rankings. No paths, games or profiles included.",
  "presets": [
    {
      "game": "SkyRoads",
      "reason": "SR first keeps the road edges and cockpit labels steadier than native NR at maximum strength.",
      "mcp_tool": "dosbox_effects",
      "arguments": {
        "renderer": "phoenix",
        "enabled": true,
        "intensity": 0.9,
        "tone": 1,
        "structure": 1.1,
        "passes": 1,
        "style": 0,
        "compare": false,
        "upscaling": true,
        "upscale_factor": 4,
        "upscale_order": "before_nr",
        "frame_generation": true,
        "input_resize": false,
        "input_scale": 1.5,
        "input_filter": "nearest"
      }
    },
